# Contact form delivery (src/app/api/contact/route.ts)
# Create an API key at https://resend.com and verify the sending domain first.
# Without RESEND_API_KEY the contact form shows visitors the direct email address
# instead of pretending the message was sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@inzint.com
CONTACT_FROM_EMAIL="Inzint Website <website@inzint.com>"
